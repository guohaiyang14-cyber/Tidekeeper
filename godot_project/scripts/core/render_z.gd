# ============================================================================
# RenderZ — 渲染层级（CanvasItem.z_index）单一来源
# 层级栈（2026-10-23 黑夜可读性，数值只在本文档定义）：
#   地面背景 -100 < 雾罩 80 < 雾上内容 81（玩家弹道/特效/召唤物/环绕锁链/
#   经验珠/潮币/宝箱/灯塔光效） < 灯塔塔身 82 < 散落光源 83 < 玩家 84
# 为什么集中：原各脚本各自 `const Z_ABOVE_FOG = 81`，改层级要改 7 处且容易漏；
#   业务脚本一律 `preload("res://scripts/core/render_z.gd")` 后引用常量
#   （不用 class_name：headless 下无编辑器导入，全局类缓存可能未注册）。
# 红线：本文件只放层级常量，不读 config、不持有状态。
# ============================================================================
extends RefCounted

## 黑夜雾罩（VisionOverlay 绝对层级）
const FOG: int = 80
## 雾罩之上：玩家侧对象 / 灯塔光束与命中闪光（只提亮不遮挡）
const ABOVE_FOG: int = 81
## 灯塔塔身（精灵剪影；低于散落光源与玩家）
const LIGHTHOUSE_BODY: int = 82
## 散落光源素材（荧光藻/贝类/夜明珠）
const SCATTERED_LIGHT: int = 83
## 玩家本体（最高：纯黑里也能看见自己）
const PLAYER: int = 84
