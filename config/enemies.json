    "difficulty": {
      "health_per_night": 0.10,
      "health_per_5nights": 0.15,
      "damage_per_night": 0.04,
      "region_coeff": 1.0
    },
    "difficulty_formula": {
      "health": "base_health × region_coeff × (1 + health_per_night × night) × (1 + health_per_5nights × floor(night/5))",
      "damage": "base_damage × (1 + damage_per_night × night)",
      "count": "base_count × (1 + 0.06 × night) × (1 + 0.20 × floor(night/5))",
      "note": "系数见本块 difficulty；调参改表不改脚本"
    },
    "density_budget": "同屏 350~450（PC 60fps）；前 5 夜峰值 60，第 10 夜 200，第 15 夜 320，第 20 夜 450 + Boss",
