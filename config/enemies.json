{
  "metadata": {
    "schema_version": 1,
    "doc_source": "主设计文档 v0.3.4 §5.3 敌人 + §5.4 词缀 + §9.4 MVP 底数表 + §8.2 数值公式",
    "mvp_scope": "9 种敌人（基础数值，运行时按 §8.2 公式缩放）",
    "ai_update_groups": {
      "1": "每帧（远程：潮汐召唤师）",
      "2": "每 2 帧（近战：小水鬼/铁壳蟹/深潜者/渊潮长枪兵/暗礁巨人）",
      "4": "每 4 帧（小怪/召唤物：水母浮游/爆炸贝/鸦群）"
    },
    "difficulty": {
      "health_per_night": 0.10,
      "health_per_5nights": 0.15,
      "damage_per_night": 0.04,
      "region_coeff": 1.0
    },
    "difficulty_formula": {
      "health": "base_health × region_coeff × (1 + health_per_night × night) × (1 + health_per_5nights × floor(night/5))",
      "damage": "base_damage × (1 + damage_per_night × night)",
      "count": "实现：spawn.base_count + spawn.per_night×(night-1)，再 × DifficultySystem 档位倍率 × budget_exp_redundancy（旧 0.06/0.20 公式未用于刷怪数）",
      "note": "系数见本块 difficulty；调参改表不改脚本"
    },
    "density_budget": "同屏 350~450（PC 60fps）；前 5 夜峰值 60，第 10 夜 200，第 15 夜 320，第 20 夜 450 + Boss。实现：min_active+min_active_per_night×(night-1) 作在屏 floor，预算 base+per_night 对齐峰值曲线",
    "spawn": {
      "base_count": 40,
      "per_night": 18,
      "interval_start": 1.0,
      "interval_dense": 0.4,
      "interval_pressure": 0.18,
      "sparse_seconds": 12.0,
      "budget_pace": "even",
      "budget_slack_sec": 5.0,
      "budget_exp_redundancy": 1.25,
      "note_budget_pace": "even=有经验预算按（夜长−slack）均匀进度释放；落后时 pressure/burst 追赶；进度超前用无掉落 floor 顶压；slack=夜末捡珠空窗；进昼未拾珠/币丢弃（不全局入账）；屏外超时见 pickups.offscreen_despawn_sec；redundancy=预算数量成长冗余。约束：夜1预算(base×redundancy)≥约2×min_active，避免 even 超前窗口被无掉落 floor 稀释升级",
      "ring_min": 140.0,
      "ring_extra": 160.0,
      "opening_grace_sec": 2.5,
      "note_opening_grace": "每夜开局缓冲：此前不刷杂兵/精英波；预算时钟从缓冲结束后起算（无开局无敌，避免污染 enter_night/挫败感机检）",
      "elite_offset_y": -200.0,
      "boss_offset_y": -220.0,
      "retry_delay": 0.1,
      "min_active": 18,
      "min_active_per_night": 6,
      "max_floor_refill": 0,
      "floor_refill_burst": 8,
      "floor_refill_interval": 0.08,
      "note_floor": "floor=min_active+min_active_per_night×(night-1)，封顶 max_enemies；active<floor 时补刷：预算已尽或 even 进度超前均可；max_floor_refill=0 不封顶；补刷怪无经验/潮币/进化/挣扎击杀；floor_refill_burst/interval 控制批量回补节奏；floor 略低于预算曲线以保留割草压感且不挤占有经验配额"
    },
    "elite": {
      "base_enemy_id": "iron_crab",
      "id": "giant_claw_king",
      "name": "巨钳王",
      "health_mult": 3,
      "exp_mult": 3,
      "contact_damage_mult": 2,
      "note": "倍率在 configure() 后仍叠 §8.2 夜晚缩放，实战为正常缩放后约 health_mult×；W8 另附 2~3 词缀"
    },
    "combat": {
