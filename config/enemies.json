    },
    "affix_rules": {
      "teaching_nights_no_affix": 4,
      "elite_affix_min": 2,
      "elite_affix_max": 3,
      "calamity_nights": [10, 15, 20],
      "calamity_bonus_affixes": 1,
      "note": "§5.4 精英=基础×2~3词缀；§5.5 第10夜全场+1词缀（当夜统一抽取）；前4夜教学无词缀。侵蚀等级不进 MVP"
    },
    "exp_drop_note": "base_exp 为击杀掉落经验珠的基础经验值；W2 调参，对齐 §6.2 升级曲线 E(1)=22",
    "coin_drop_note": "原型潮币掉落 = max(1, round(base_exp))；完整掉落表见 §5.2",
    "note": "运行时只读；行为类型对应 EnemyBase 分派实现；运行期参数（move_speed 等）在此表"
  },
