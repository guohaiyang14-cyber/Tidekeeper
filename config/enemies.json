  "metadata": {
    "schema_version": 1,
    "doc_source": "主设计文档 v0.3.4 §5.3 敌人 + §9.4 MVP 底数表 + §8.2 数值公式",
    "mvp_scope": "9 种敌人（基础数值，运行时按 §8.2 公式缩放）",
    "ai_update_groups": {
      "1": "每帧（远程：潮汐召唤师）",
      "2": "每 2 帧（近战：小水鬼/铁壳蟹/深潜者/渊潮长枪兵/暗礁巨人）",
      "4": "每 4 帧（小怪/召唤物：水母浮游/爆炸贝/鸦群）"
    },
    "difficulty_formula": {
      "health": "base_health × region_coeff × (1 + 0.10 × night) × (1 + 0.15 × floor(night/5))",
      "damage": "base_damage × (1 + 0.04 × night)",
      "count": "base_count × (1 + 0.06 × night) × (1 + 0.20 × floor(night/5))",
      "region_coeff_mvp": 1.0,
      "note": "MVP 仅靠本公式 + 天灾夜尖峰调难度；调参改表不改公式"
    },
    "density_budget": "同屏 350~450（PC 60fps）；前 5 夜峰值 60，第 10 夜 200，第 15 夜 320，第 20 夜 450 + Boss",
    "note": "运行时只读；行为类型对应 enemy_*_behavior.gd 实现"
  },
