﻿# =============================================================================
# 潮汐守夜人 (Tidekeeper) — .gitignore
# 引擎：Godot 4.7.1  ｜  工具链：Python 3 + Git + VS Code
# =============================================================================

# -----------------------------------------------------------------------------
# Godot 4.x — 导入缓存与编辑器临时文件
# -----------------------------------------------------------------------------
# .godot/ 是 4.x 的导入缓存目录（替代旧版 .import 文件），不应入库
.godot/

# 编辑器运行时日志 / 临时配置
*.log
logs/
editor_data/

# 用户级覆盖配置（每人本地不同）
override.cfg

# 导出预设的本地密钥/签名（保留 export_presets.cfg 本身，仅忽略密钥段）
export_credentials.cfg

# -----------------------------------------------------------------------------
# 构建产物 / 导出包
# -----------------------------------------------------------------------------
/builds/
/exports/
/dist/
*.exe
*.app
*.x86_64
*.pck
*.zip

# 调试符号
*.pdb
*.debug

# -----------------------------------------------------------------------------
# Python 工具脚本
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
env/
ENV/

# 测试 / 覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 分发包
build/
dist/
*.egg-info/
*.egg

# -----------------------------------------------------------------------------
# IDE / 编辑器
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.trae/.cache/

# -----------------------------------------------------------------------------
# 操作系统
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------------------------------------
# 项目专用 — 生成产物与本地数据
# -----------------------------------------------------------------------------
# 经验表必须由 tools/generate_exp_table.py 生成，但需入库供运行时读取
# → config/exp_table.json 不忽略（受红线保护，禁止手改）

# 本地试玩记录 / 存档（不入库）
savegame.json
saves/
*.save

# agent 临时工作文件
.agent_tmp/
*.agent_diff
